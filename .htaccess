# Heartfolio

# Don't list folder contents
Options -Indexes

# Never serve these file types directly
<FilesMatch "\.(sql|log|md|sh|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Allow customer photo uploads (several photos per magazine)
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 64M
    php_value max_file_uploads 20
</IfModule>
